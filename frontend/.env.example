# FIXVO PROD ENVIRONMENT VARIABLES - FRONTEND
# Rename this file to .env before deploying to Vercel/Netlify

# Production API URL
VITE_API_URL=https://api.yourstartup.co/api

# Stripe Production Public Key
VITE_STRIPE_PUBLIC_KEY=pk_live_YOUR_PRODUCTION_STRIPE_KEY_HERE

# Google OAuth
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id

# ─── Phase 8: Monitoring & Analytics ─────────────────────────────────────────

# Sentry — Frontend error tracking (React)
# Get DSN from: https://sentry.io → Your Project → Settings → Client Keys (DSN)
# IMPORTANT: This is the FRONTEND DSN (separate from backend)
VITE_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/xxx

# Application version — used for Sentry release tracking
# Set to your current git tag or semver (e.g., fixvo-frontend@1.2.0)
VITE_APP_VERSION=fixvo-frontend@1.0.0

# Mixpanel — Client-side product analytics
# Get token from: https://mixpanel.com → Your Project → Settings → Project Token
# NOTE: This token is safe to expose in the frontend bundle.
# It only permits event ingestion — no data access.
VITE_MIXPANEL_TOKEN=your_mixpanel_project_token
