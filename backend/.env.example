# FIXVO PROD ENVIRONMENT VARIABLES - BACKEND
# Rename this file to .env before deploying to Render/Heroku

PORT=5000

# Production Database (Do not use your local or test DB)
MONGODB_URI=mongodb+srv://<admin_user>:<secure_password>@cluster0.mongodb.net/quickrepair_prod?retryWrites=true&w=majority

# Strong Cryptographic Key for User Sessions
JWT_SECRET=YOUR_64_CHARACTER_SECURE_RANDOM_STRING

# Stripe Secret Key (DO NOT EXPOSE TO FRONTEND)
STRIPE_SECRET_KEY=sk_live_YOUR_PRODUCTION_STRIPE_SECRET_HERE

# CORS Safety (Only allow requests from your actual domain)
FRONTEND_URL=https://quickrepair.co

# KYC Encryption Key — AES-256-GCM key for encrypting bank details at rest
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be a 64-character hex string (32 bytes). NEVER commit the real value.
KYC_ENCRYPTION_KEY=YOUR_64_CHARACTER_HEX_ENCRYPTION_KEY

# Cloudinary — Private document storage for KYC documents
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin Notification Email
ADMIN_EMAIL=admin@fixvo.com

# ─── Phase 8: Monitoring & Analytics ─────────────────────────────────────────

# Sentry — Backend error tracking (Node.js)
# Get DSN from: https://sentry.io → Your Project → Settings → Client Keys (DSN)
SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/xxx

# Application version — used for Sentry release tracking
# Set to your current git tag or semver (e.g., fixvo@1.2.0)
APP_VERSION=fixvo@1.0.0

# Node environment — MUST be set to 'production' in prod deployments
# Values: development | staging | production | test
NODE_ENV=production

# Log level for Winston structured logger
# Values: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# Mixpanel — Server-side product analytics (optional)
# Get token from: https://mixpanel.com → Your Project → Settings → Project Token
# Safe to use server-side only; keep separate from frontend token
MIXPANEL_TOKEN=your_server_side_mixpanel_project_token

# WhatsApp Business Cloud API (Meta)
WA_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WA_ACCESS_TOKEN=your_whatsapp_access_token
WA_WEBHOOK_VERIFY_TOKEN=your_chosen_webhook_verify_token
WA_WEBHOOK_SECRET=your_whatsapp_app_secret

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Admin Account Security
ADMIN_RECOVERY_KEY=YOUR_SECURE_ADMIN_CREATION_SECRET_KEY

# Email Notifications (Nodemailer / Resend)
EMAIL_USER=notifications@fixvo.com
EMAIL_PASS=your_smtp_password
RESEND_API_KEY=re_your_resend_api_key
